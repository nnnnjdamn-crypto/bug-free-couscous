rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function activeUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.banned != true;
    }
    match /users/{uid} {
      allow read: if activeUser() && (signedIn() || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.banned == false
        && !('role' in request.resource.data);
      allow update: if isAdmin()
        || (activeUser() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName','photoURL','updatedAt']));
      allow delete: if isAdmin();
    }
    match /conversations/{conversationId} {
      function member() {
        return activeUser() && request.auth.uid in resource.data.members;
      }
      allow read: if member();
      allow create: if activeUser()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members;
      allow update: if member()
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['lastMessage','updatedAt']);
      allow delete: if isAdmin();
      match /messages/{messageId} {
        function conversationMember() {
          return activeUser()
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;
        }
        allow read: if conversationMember();
        allow create: if conversationMember()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.keys().hasOnly(['senderId','senderName','text','createdAt']);
        allow update, delete: if isAdmin();
      }
    }
  }
}